<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Forge" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/forge_background</item>
        <item name="android:statusBarColor">@color/forge_background</item>
        <item name="android:navigationBarColor">@color/forge_background</item>
    </style>
    <style name="Theme.Forge.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/forge_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_forge_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Forge</item>
    </style>
</resources>
